            ],
            "url": {
              "raw": "{{baseUrl}}/api/employees",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "employees"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"\",\n  \"email\": \"not-an-email\",\n  \"phoneNumber\": \"123\",\n  \"department\": \"\",\n  \"designation\": \"\",\n  \"dateOfJoining\": null,\n  \"salary\": -100,\n  \"status\": \"ACTIVE\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 400\", function () {",
                  "    pm.response.to.have.status(400);",
                  "});",
                  "pm.test(\"Field errors are returned\", function () {",
                  "    const errors = pm.response.json().fieldErrors;",
                  "    pm.expect(errors).to.have.property(\"email\");",
                  "    pm.expect(errors).to.have.property(\"salary\");",
                  "});"
                ]
              }
            }
          ]
        },
