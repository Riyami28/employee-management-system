              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Postman Test User\",\n  \"email\": \"{{employeeEmail}}\",\n  \"phoneNumber\": \"+919876543210\",\n  \"department\": \"Engineering\",\n  \"designation\": \"Software Engineer\",\n  \"dateOfJoining\": \"2025-07-01\",\n  \"salary\": 900000.0,\n  \"status\": \"ACTIVE\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 409\", function () {",
                  "    pm.response.to.have.status(409);",
                  "});",
                  "pm.test(\"Explains the conflict\", function () {",
                  "    pm.expect(pm.response.json().message).to.include(\"already exists\");",
                  "});"
                ]
              }
            }
          ]
        },
